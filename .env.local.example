# =============================================================================
# Local Development — copy to .env (do NOT use Docker service hostnames)
# =============================================================================
# Use with: docker compose -f docker-compose.infra.yml up -d
# Then run API, workers, and frontend on your machine (see docs/LOCAL_DEV.md)

APP_NAME=AI Job Agent
APP_ENV=production
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-64-char-random-string
API_V1_PREFIX=/api/v1
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# --- Infrastructure (localhost — from docker-compose.infra.yml) ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ai_job_agent
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
PROMPTS_DIR=prompts
CONFIGS_DIR=configs

# --- Storage ---
STORAGE_PROVIDER=local
STORAGE_ROOT=storage
RESUME_STORAGE_DIR=resumes
GENERATED_RESUME_DIR=generated-resumes
COVER_LETTER_DIR=cover-letters
PROFILE_IMAGE_DIR=profile-images
TEMP_DIR=temp

# --- JWT ---
JWT_SECRET_KEY=change-me-jwt-secret-min-16-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Frontend (Vite dev server talks directly to FastAPI) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_BASE_URL=http://localhost:5173

# --- Email (optional — verification links logged to console if empty) ---
EMAIL_VERIFICATION_EXPIRE_HOURS=24
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# --- Resume upload limits ---
MAX_RESUME_SIZE_MB=10
ALLOWED_RESUME_EXTENSIONS=pdf
