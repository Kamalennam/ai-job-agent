# =============================================================================
# LOCAL OVERRIDES — copy to .env.local on your laptop (never commit .env.local)
# =============================================================================
#   Copy-Item .env.local.example .env.local
#
# Loaded AFTER .env — only these keys override your shared .env file.
# Production server: do NOT create .env.local (uses .env only, unchanged).
#
# Keep secrets (MongoDB, JWT, SMTP) in .env once; override hostnames here for local dev.
# =============================================================================

APP_ENV=development
APP_DEBUG=true

API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
OLLAMA_BASE_URL=http://localhost:11434
# Model installed in local Ollama (`ollama list`). Hostinger .env stays llama3.2.
OLLAMA_MODEL=llama3.1

VITE_API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_BASE_URL=http://localhost:5173

STORAGE_ROOT=storage

# --- Resume job matching (optional; code defaults match these values) ---
# MIN_JOB_MATCH_SCORE=60
# MATCH_WEIGHT_SKILL=0.50
# MATCH_WEIGHT_ROLE=0.20
# MATCH_WEIGHT_EXPERIENCE=0.15
# MATCH_WEIGHT_PROJECT=0.10
# MATCH_WEIGHT_OTHER=0.05
