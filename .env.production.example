# =============================================================================
# Hostinger Production — copy to .env on the server
# Never commit the real .env to version control.
# =============================================================================

APP_NAME=AI Job Agent
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=change-me-to-a-64-char-random-string
API_V1_PREFIX=/api/v1
API_BASE_URL=http://187.127.146.159:8001
CORS_ORIGINS=http://187.127.146.159,http://187.127.146.159:5173,http://187.127.146.159:8001

# MongoDB Atlas (or server-hosted MongoDB)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/
MONGODB_DB_NAME=ai_job_agent

# Docker service hostnames (internal to compose network)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
PROMPTS_DIR=/app/prompts
CONFIGS_DIR=/app/configs

# JWT — use strong secrets (32+ characters) in production
JWT_SECRET_KEY=REPLACE_WITH_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend — baked into the production image at build time
VITE_API_BASE_URL=http://187.127.146.159:8001/api/v1
FRONTEND_BASE_URL=http://187.127.146.159

# Email
EMAIL_VERIFICATION_EXPIRE_HOURS=24
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Storage
STORAGE_PROVIDER=local
STORAGE_ROOT=/app/storage
RESUME_STORAGE_DIR=resumes
GENERATED_RESUME_DIR=generated-resumes
COVER_LETTER_DIR=cover-letters
PROFILE_IMAGE_DIR=profile-images
TEMP_DIR=temp

MAX_RESUME_SIZE_MB=10
ALLOWED_RESUME_EXTENSIONS=pdf

NGINX_PORT=80
