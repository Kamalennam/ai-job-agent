# =============================================================================
# PRODUCTION (Hostinger VPS) — copy to .env on the server (never commit .env)
# =============================================================================
#   cp .env.production.example .env
#   nano .env   # fill secrets, MongoDB Atlas URI, SMTP, server IP/domain
#
# Server only — do NOT copy this file to your laptop as .env.local.
# Local development uses .env.local from .env.local.example instead.
# =============================================================================

APP_NAME=AI Job Agent
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=REPLACE_WITH_openssl_rand_hex_32
API_V1_PREFIX=/api/v1
API_BASE_URL=http://YOUR_SERVER_IP_OR_DOMAIN
CORS_ORIGINS=http://YOUR_SERVER_IP_OR_DOMAIN,http://YOUR_SERVER_IP_OR_DOMAIN:5173

# --- MongoDB Atlas (no local MongoDB in docker-compose.prod.yml) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/
MONGODB_DB_NAME=ai_job_agent

# --- Docker Compose service hostnames (inside prod stack) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
PROMPTS_DIR=prompts
CONFIGS_DIR=configs

# --- JWT (32+ characters required in production) ---
JWT_SECRET_KEY=REPLACE_WITH_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Frontend (baked into image at build time) ---
VITE_API_BASE_URL=/api/v1
FRONTEND_BASE_URL=http://YOUR_SERVER_IP_OR_DOMAIN

# --- Email ---
EMAIL_VERIFICATION_EXPIRE_HOURS=24
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# --- Storage (Docker volume mount) ---
STORAGE_PROVIDER=local
STORAGE_ROOT=/app/storage
RESUME_STORAGE_DIR=resumes
GENERATED_RESUME_DIR=generated-resumes
COVER_LETTER_DIR=cover-letters
PROFILE_IMAGE_DIR=profile-images
TEMP_DIR=temp

# --- Resume upload limits ---
MAX_RESUME_SIZE_MB=10
ALLOWED_RESUME_EXTENSIONS=pdf

# --- Resume job matching (optional; defaults used when unset) ---
# MIN_JOB_MATCH_SCORE=60
# MATCH_WEIGHT_SKILL=0.50
# MATCH_WEIGHT_ROLE=0.20
# MATCH_WEIGHT_EXPERIENCE=0.15
# MATCH_WEIGHT_PROJECT=0.10
# MATCH_WEIGHT_OTHER=0.05

# --- Nginx (Docker nginx unused on Hostinger; host nginx on :80) ---
NGINX_PORT=80
