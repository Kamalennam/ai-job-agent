# =============================================================================
# AI Job Agent — Environment Variables
# Copy to .env and fill in values. Never commit .env to version control.
#
# Local dev (Python on host): use localhost URLs below.
# Full Docker Compose: swap hostnames to service names (mongodb, redis, ollama)
#   and set STORAGE_ROOT=/app/storage
# =============================================================================

# --- Application ---
APP_NAME=AI Job Agent
APP_ENV=production
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-64-char-random-string
API_V1_PREFIX=/api/v1
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# --- MongoDB ---
# Docker Compose: MONGODB_URI=mongodb://mongodb:27017
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ai_job_agent

# --- Redis (Celery broker + cache) ---
# Docker Compose: REDIS_URL=redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- JWT Authentication ---
JWT_SECRET_KEY=change-me-jwt-secret-min-16-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Ollama (Local AI) ---
# Docker Compose: OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
PROMPTS_DIR=prompts
CONFIGS_DIR=configs
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_EXTRACTION_TEMPERATURE=0.3

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_BASE_URL=http://localhost:5173

# --- Email (optional — verification links logged to console when incomplete) ---
EMAIL_VERIFICATION_EXPIRE_HOURS=24
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# --- Storage (MongoDB stores relative paths only; URLs built at API response time) ---
STORAGE_PROVIDER=local
STORAGE_ROOT=storage
RESUME_STORAGE_DIR=resumes
GENERATED_RESUME_DIR=generated-resumes
COVER_LETTER_DIR=cover-letters
PROFILE_IMAGE_DIR=profile-images
TEMP_DIR=temp

# --- Resume upload limits ---
MAX_RESUME_SIZE_MB=10
ALLOWED_RESUME_EXTENSIONS=pdf

# --- Playwright (ATS Automation — future phases) ---
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_USER_DATA_DIR=/app/playwright-data

# --- Scheduler (future phases) ---
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC

# --- Job Collectors (future phases) ---
JOB_COLLECT_INTERVAL_HOURS=1
JOB_MATCH_INTERVAL_MINUTES=30
RESUME_OPTIMIZE_CRON=0 2 * * *
ANALYTICS_CRON=0 * * * *
CLEANUP_CRON=0 3 * * 0
HEALTH_CHECK_CRON=*/5 * * * *

# --- Rate Limiting (future phases) ---
RATE_LIMIT_PER_MINUTE=60

# --- Monitoring (optional) ---
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=false

# --- Nginx (Docker Compose) ---
NGINX_PORT=80
